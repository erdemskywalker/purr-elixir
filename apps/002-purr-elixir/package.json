{
  "name": "purr-elixir",
  "version": "1.0.0",
  "private": true,
  "description": "Purr Elixir — Built with Erdem App Factory",
  "scripts": {
    "postinstall": "node scripts/patch-admob-ios.mjs",
    "prepare:www": "node ../../tools/bundle_www.mjs --app .",
    "sync:ios": "node scripts/patch-admob-ios.mjs && npm run prepare:www && npx cap sync ios",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "@capacitor/clipboard": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor-community/sqlite": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
